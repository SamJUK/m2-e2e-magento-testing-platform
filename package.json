{
  "name": "m2-e2e-magento-testing-platform",
  "private": true,
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "build:watch": "pnpm -r --filter './packages/*' --parallel build:watch",
    "lint": "pnpm -r --filter './packages/*' lint",
    "clean": "pnpm -r --filter './packages/*' clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish",
    "stack:up": "tests/docker/run.sh up",
    "stack:test": "tests/docker/run.sh test",
    "stack:down": "tests/docker/run.sh down"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@11.1.3",
  "license": "OSL-3.0"
}
