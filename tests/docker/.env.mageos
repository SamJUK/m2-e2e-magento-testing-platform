# Mage-OS + Luma. Distro canary: proves the SAME theme-luma package passes on
# Mage-OS, which is the assertion that fails the day Mage-OS starts diverging.
# 3.x is published for php8.4/8.5 only — there is no 3.x-php8.3 tag, which is
# why the previously pinned 3.1.0-php8.3 failed with "manifest unknown".
MAGENTO_IMAGE=ghcr.io/samjuk/mage-os-ci-testing-env:3.5.0-php8.4
NGINX_PORT=8081
MAILPIT_HTTP_PORT=8826
THEME=luma
