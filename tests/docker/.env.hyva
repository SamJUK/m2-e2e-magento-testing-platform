# Magento Open Source + Hyva. Its own stack, ports and volumes: Hyva is
# installed into the store at setup time and switches design/theme/theme_id,
# so it cannot share a database with the Luma target — whichever installed
# last would decide which markup the other target's suite asserts against.
MAGENTO_IMAGE=ghcr.io/samjuk/magento-ci-testing-env:2.4.8-php8.3
NGINX_PORT=8082
MAILPIT_HTTP_PORT=8827
THEME=hyva
