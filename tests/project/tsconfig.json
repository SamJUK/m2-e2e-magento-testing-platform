{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "declaration": false,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "paths": {
      "#test": ["./fixtures.ts"]
    }
  },
  "include": ["*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "test-results", "test-report"]
}
