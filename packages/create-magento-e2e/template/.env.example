# Store-specific settings. Gitignored: this file holds admin credentials.

# Self-signed certs on local domains
NODE_TLS_REJECT_UNAUTHORIZED=0

PLAYWRIGHT_BASE_URL=https://app.example.test
MAILPIT_URL=https://webmail.warden.test

PLAYWRIGHT_ADMIN_SLUG=/admin
PLAYWRIGHT_ADMIN_USERNAME=playwright
PLAYWRIGHT_ADMIN_PASSWORD=Password1

# none | dump-restore | s3-import
DB_STRATEGY=dump-restore
